{
    "framework": "vite",
    "buildCommand": "vite build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/api/gitlab/:path*",
            "destination": "/api/gitlab"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}